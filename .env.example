# --- Telegram (obligatorio) ---
TELEGRAM_BOT_TOKEN=
# Único chat autorizado; el bot ignora a cualquier otro.
TELEGRAM_CHAT_ID=

# --- General ---
TZ_DISPLAY=Europe/Madrid
DB_PATH=/var/lib/netmonitor/netmonitor.db
ROUTER_LABEL=Mi router
# Vacío = autodetectar desde la ruta por defecto
IFACE=
GATEWAY=

# --- Intervalos ---
CYCLE_SECONDS=30
SPEEDTEST_MINUTES=90
# cloudflare = integrado (speed.cloudflare.com, sin instalar nada) | cli = speedtest-cli / Ookla instalado en el sistema
SPEEDTEST_BACKEND=cloudflare
LINK_SECONDS=300
TRACE_HOURS=6
# Fallos consecutivos para declarar caída / aciertos para darla por terminada
FAIL_THRESHOLD=3
RECOVER_THRESHOLD=2

# --- Objetivos ---
PING_TARGETS=1.1.1.1,8.8.8.8,9.9.9.9
DNS_DOMAINS=google.com,wikipedia.org,cloudflare.com
DNS_RESOLVERS_PUBLIC=1.1.1.1,8.8.8.8
# Minutos seguidos de DNS del operador degradado (sin ser caída) antes de avisar
DNS_DEGRADED_ALERT_MIN=15
HTTP_URLS=https://www.google.com/generate_204,https://www.cloudflare.com/cdn-cgi/trace,https://www.apple.com/library/test/success.html
TRACE_TARGET=1.1.1.1

# --- Almacenamiento ---
RETENTION_DAYS=30
AGG_RETENTION_DAYS=365
MAX_DB_MB=500
